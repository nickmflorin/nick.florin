/prisma/db.sqlite-journal

# NextJS
/.next/
/out/
next-env.d.ts

# Production
/build

# Misc
.DS_Store
*.pem

# ESLint Caches
#
# Written by the cached and format-only ESLint scripts ('eslint:cached', 'eslint:format:fast'), both
# of which are local development conveniences only.
.eslintcache
.eslintcache.*

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local Environment Files
.env*.local
.env

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
*.generated.ts

# NextJS Bundle Analyzer
/analyze

# Fixtures
/src/database/fixtures/json/fake/
.env*

# Prisma Generated Client
#
# Rebuilt in full by 'prisma generate', which runs on postinstall and again as part of the build, so
# it never needs to be committed.  Keeping it out of source control also keeps the platform-specific
# query engine binary (~16MB, and wrong for any platform other than the one that generated it) out
# of the repository.
/src/database/model/generated/
