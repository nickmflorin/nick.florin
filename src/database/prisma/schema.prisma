generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
  output          = "../model/generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // Uses Connection Pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // Uses a Direct Connection
}

model User {
  id                   String         @id @default(uuid()) @db.Uuid
  clerkId              String         @unique
  firstName            String
  lastName             String
  profileImageUrl      String?
  emailAddress         String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  updatedSkills        Skill[]        @relation("updatedSkills")
  createdSkills        Skill[]        @relation("createdSkills")
  updatedCompanies     Company[]      @relation("updatedCompanies")
  createdCompanies     Company[]      @relation("createdCompanies")
  updatedExperiences   Experience[]   @relation("updatedExperiences")
  createdExperiences   Experience[]   @relation("createdExperiences")
  updatedSchools       School[]       @relation("updatedSchools")
  createdSchools       School[]       @relation("createdSchools")
  updatedEducations    Education[]    @relation("updatedEducations")
  createdEducations    Education[]    @relation("createdEducations")
  updatedProfiles      Profile[]      @relation("updatedProfiles")
  createdProfiles      Profile[]      @relation("createdProfiles")
  updatedDetails       Detail[]       @relation("updatedDetails")
  createdDetails       Detail[]       @relation("createdDetails")
  updatedNestedDetails NestedDetail[] @relation("updatedNestedDetails")
  createdNestedDetails NestedDetail[] @relation("createdNestedDetails")
  updatedCourses       Course[]       @relation("updatedCourses")
  createdCourses       Course[]       @relation("createdCourses")
  updatedProjects      Project[]      @relation("updatedProjects")
  createdProjects      Project[]      @relation("createdProjects")
  updatedRepositories  Repository[]   @relation("updatedRepositories")
  createdRepositories  Repository[]   @relation("createdRepositories")
  updatedResumes       Resume[]       @relation("updatedResumes")
  createdResumes       Resume[]       @relation("createdResumes")

  updatedCompetencies             Competency[]              @relation("updatedCompetencies")
  createdCompetencies             Competency[]              @relation("createdCompetencies")
  updatedRoles                    Role[]                    @relation("updatedRoles")
  createdRoles                    Role[]                    @relation("createdRoles")
  updatedDegrees                  Degree[]                  @relation("updatedDegrees")
  createdDegrees                  Degree[]                  @relation("createdDegrees")
  updatedContentNodes             ContentNode[]             @relation("updatedContentNodes")
  createdContentNodes             ContentNode[]             @relation("createdContentNodes")
  updatedNestedContentNodes       NestedContentNode[]       @relation("updatedNestedContentNodes")
  createdNestedContentNodes       NestedContentNode[]       @relation("createdNestedContentNodes")
  updatedProfileAboutParagraphs   ProfileAboutParagraph[]   @relation("updatedProfileAboutParagraphs")
  createdProfileAboutParagraphs   ProfileAboutParagraph[]   @relation("createdProfileAboutParagraphs")
  updatedProfileHighlights        ProfileHighlight[]        @relation("updatedProfileHighlights")
  createdProfileHighlights        ProfileHighlight[]        @relation("createdProfileHighlights")
  updatedProfileContactEntries    ProfileContactEntry[]     @relation("updatedProfileContactEntries")
  createdProfileContactEntries    ProfileContactEntry[]     @relation("createdProfileContactEntries")
  updatedResumeSheets             ResumeSheet[]             @relation("updatedResumeSheets")
  createdResumeSheets             ResumeSheet[]             @relation("createdResumeSheets")
  updatedResumeCompetenciesGroups ResumeCompetenciesGroup[] @relation("updatedResumeCompetenciesGroups")
  createdResumeCompetenciesGroups ResumeCompetenciesGroup[] @relation("createdResumeCompetenciesGroups")
}

model NestedDetail {
  id               String   @id @default(uuid()) @db.Uuid
  createdAt        DateTime @default(now())
  createdBy        User     @relation("createdNestedDetails", fields: [createdById], references: [id])
  createdById      String   @db.Uuid
  updatedAt        DateTime @updatedAt
  updatedBy        User     @relation("updatedNestedDetails", fields: [updatedById], references: [id])
  updatedById      String   @db.Uuid
  label            String
  description      String?
  shortDescription String?
  visible          Boolean  @default(true)
  detail           Detail   @relation("nestedDetails", fields: [detailId], references: [id])
  detailId         String   @db.Uuid
  project          Project? @relation("nestedDetails", fields: [projectId], references: [id])
  projectId        String?  @db.Uuid
  skills           Skill[]  @relation("nestedDetailSkills")

  @@unique([label, detailId])
}

enum DetailEntityType {
  EXPERIENCE
  EDUCATION
}

model Detail {
  id               String           @id @default(uuid()) @db.Uuid
  createdAt        DateTime         @default(now())
  createdBy        User             @relation("createdDetails", fields: [createdById], references: [id])
  createdById      String           @db.Uuid
  updatedAt        DateTime         @updatedAt
  updatedBy        User             @relation("updatedDetails", fields: [updatedById], references: [id])
  updatedById      String           @db.Uuid
  entityId         String           @db.Uuid
  entityType       DetailEntityType
  label            String
  description      String?
  shortDescription String?
  visible          Boolean          @default(true)
  nestedDetails    NestedDetail[]   @relation("nestedDetails")
  project          Project?         @relation("details", fields: [projectId], references: [id])
  projectId        String?          @db.Uuid
  skills           Skill[]          @relation("detailSkills")

  @@unique([label, entityId, entityType])
}

enum SkillCategory {
  DEVOPS
  DATABASE
  API_DEVELOPMENT
  TESTING
  PROGRAMMING_LANGUAGE
  FRAMEWORK
  PACKAGE
  PACKAGE_MANAGER
  VERSION_MANAGER
  LOGGING_ALERTING_MONITORING
  ACADEMIC
  ORM
  WORKFLOW
}

enum ProgrammingDomain {
  BACKEND
  FRONTEND
  MOBILE
  FULL_STACK
  INFRASTRUCTURE
}

enum ProgrammingLanguage {
  JAVASCRIPT
  TYPESCRIPT
  PYTHON
  SWIFT
  CSS
  SCSS
  CPLUSPLUS
  BASH
  JQUERY
  HTML
  MATLAB
  R
  REACT
  VBA
}

model Resume {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  createdBy   User     @relation("createdResumes", fields: [createdById], references: [id])
  createdById String   @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedBy   User     @relation("updatedResumes", fields: [updatedById], references: [id])
  updatedById String   @db.Uuid
  primary     Boolean  @default(false)
  downloadUrl String
  url         String
  pathname    String
  filename    String
  size        BigInt
}

model Repository {
  id             String               @id @default(uuid()) @db.Uuid
  slug           String               @unique
  description    String?
  createdAt      DateTime             @default(now())
  createdBy      User                 @relation("createdRepositories", fields: [createdById], references: [id])
  createdById    String               @db.Uuid
  updatedAt      DateTime             @updatedAt
  updatedBy      User                 @relation("updatedRepositories", fields: [updatedById], references: [id])
  updatedById    String               @db.Uuid
  skills         Skill[]              @relation("skillRepositories")
  projects       Project[]            @relation("projectRepositories")
  visible        Boolean              @default(false)
  highlighted    Boolean              @default(false)
  // The start date is used to determine the experience of a given skill in the repository.
  startDate      DateTime
  npmPackageName String?              @unique
  // Additive new-model membership (carried over intact, decided 2026-08-11): syndication
  // allowlist and competency associations. The legacy `skills` relation remains until adoption.
  channels       SyndicationChannel[] @default([])
  competencies   Competency[]         @relation("repositoryCompetencies")
}

model Skill {
  id                   String                @id @default(uuid()) @db.Uuid
  label                String                @unique
  slug                 String                @unique
  createdAt            DateTime              @default(now())
  createdBy            User                  @relation("createdSkills", fields: [createdById], references: [id])
  createdById          String                @db.Uuid
  updatedAt            DateTime              @updatedAt
  updatedBy            User                  @relation("updatedSkills", fields: [updatedById], references: [id])
  updatedById          String                @db.Uuid
  experiences          Experience[]          @relation("experienceSkills")
  educations           Education[]           @relation("educationSkills")
  visible              Boolean               @default(true)
  description          String?
  categories           SkillCategory[]       @default([])
  programmingLanguages ProgrammingLanguage[] @default([])
  programmingDomains   ProgrammingDomain[]   @default([])
  // Number of years that the skill has been used in academic/professional settings.  If not
  // defined, it may be determined based on the oldest experience and/or education it is associated
  // with.
  experience           Int?
  calculatedExperience Int
  highlighted          Boolean               @default(false)
  prioritized          Boolean               @default(false)
  courses              Course[]              @relation("courseSkills")
  projects             Project[]             @relation("projectSkills")
  details              Detail[]              @relation("detailSkills")
  nestedDetails        NestedDetail[]        @relation("nestedDetailSkills")
  repositories         Repository[]          @relation("skillRepositories")
}

model Course {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @unique
  shortName    String?              @unique
  // This is currently not being used, and we may want to remove it in the near future.
  slug         String               @unique
  createdAt    DateTime             @default(now())
  createdBy    User                 @relation("createdCourses", fields: [createdById], references: [id])
  createdById  String               @db.Uuid
  updatedAt    DateTime             @updatedAt
  updatedBy    User                 @relation("updatedCourses", fields: [updatedById], references: [id])
  updatedById  String               @db.Uuid
  education    Education            @relation("courses", fields: [educationId], references: [id])
  educationId  String               @db.Uuid
  visible      Boolean              @default(true)
  description  String?
  skills       Skill[]              @relation("courseSkills")
  // Additive new-model membership (carried over intact, decided 2026-08-11): the parallel
  // re-parent onto `Degree` (the legacy `educationId` remains until adoption), the syndication
  // allowlist, and competency associations.
  degree       Degree?              @relation("degreeCourses", fields: [degreeId], references: [id])
  degreeId     String?              @db.Uuid
  channels     SyndicationChannel[] @default([])
  competencies Competency[]         @relation("courseCompetencies")
}

model Project {
  id            String               @id @default(uuid()) @db.Uuid
  name          String               @unique
  shortName     String?              @unique
  // TODO: We may want to use a rich text editor for this in the future, so we can show it on the
  // projects page with embedded links and things of that nature.
  description   String
  slug          String               @unique
  createdAt     DateTime             @default(now())
  createdBy     User                 @relation("createdProjects", fields: [createdById], references: [id])
  createdById   String               @db.Uuid
  updatedAt     DateTime             @updatedAt
  updatedBy     User                 @relation("updatedProjects", fields: [updatedById], references: [id])
  updatedById   String               @db.Uuid
  // The start date is used to determine the experience of a given skill in the project.
  startDate     DateTime
  skills        Skill[]              @relation("projectSkills")
  details       Detail[]             @relation("details")
  nestedDetails NestedDetail[]       @relation("nestedDetails")
  repositories  Repository[]         @relation("projectRepositories")
  highlighted   Boolean              @default(false)
  visible       Boolean              @default(false)
  // Additive new-model membership (carried over intact, decided 2026-08-11): syndication
  // allowlist and competency associations. The legacy `skills` relation remains until adoption.
  channels      SyndicationChannel[] @default([])
  competencies  Competency[]         @relation("projectCompetencies")
}

model Company {
  id           String       @id @default(uuid()) @db.Uuid
  createdAt    DateTime     @default(now())
  createdBy    User         @relation("createdCompanies", fields: [createdById], references: [id])
  createdById  String       @db.Uuid
  updatedAt    DateTime     @updatedAt
  updatedBy    User         @relation("updatedCompanies", fields: [updatedById], references: [id])
  updatedById  String       @db.Uuid
  name         String       @unique
  shortName    String?      @unique
  description  String?
  logoImageUrl String?
  websiteUrl   String?
  experiences  Experience[] @relation("experiences")
  city         String
  state        String

  // Additive columns for the parallel new-model foundation. `slug` is nullable until existing
  // rows are backfilled by the fixture sync; `logoFileName` is the locally vendored logo the
  // generated resume prints from, distinct from the remote `logoImageUrl`.
  slug         String? @unique
  logoFileName String?
  roles        Role[]  @relation("roles")
}

model School {
  id           String      @id @default(uuid()) @db.Uuid
  createdAt    DateTime    @default(now())
  createdBy    User        @relation("createdSchools", fields: [createdById], references: [id])
  createdById  String      @db.Uuid
  updatedAt    DateTime    @updatedAt
  updatedBy    User        @relation("updatedSchools", fields: [updatedById], references: [id])
  updatedById  String      @db.Uuid
  name         String      @unique
  shortName    String?     @unique
  description  String?
  logoImageUrl String?
  websiteUrl   String?
  educations   Education[] @relation("educations")
  city         String
  state        String

  // Additive columns for the parallel new-model foundation; see `Company`.
  slug         String?  @unique
  logoFileName String?
  degrees      Degree[] @relation("degrees")
}

model Experience {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now())
  createdBy   User      @relation("createdExperiences", fields: [createdById], references: [id])
  createdById String    @db.Uuid
  updatedAt   DateTime  @updatedAt
  updatedBy   User      @relation("updatedExperiences", fields: [updatedById], references: [id])
  updatedById String    @db.Uuid
  skills      Skill[]   @relation("experienceSkills")
  startDate   DateTime
  endDate     DateTime?
  company     Company   @relation("experiences", fields: [companyId], references: [id])
  companyId   String    @db.Uuid
  title       String
  shortTitle  String?
  description String?
  isCurrent   Boolean   @default(false)
  isRemote    Boolean   @default(false)
  visible     Boolean   @default(true)
  highlighted Boolean   @default(true)

  @@unique([title, companyId])
}

// Renamed from `Degree` so that name is free for the parallel `Degree` model (the successor to
// `Education`) — in Postgres a table's row type shares the type namespace with enums, so the enum
// had to move in the database as well (an `ALTER TYPE ... RENAME`, metadata-only). The new
// `Degree` model uses this same enum for its academic level.
enum DegreeType {
  BACHELORS_OF_SCIENCE
  MASTERS_OF_SCIENCE_IN_ENGINEERING
  MASTERS_OF_SCIENCE
}

model Education {
  id            String     @id @default(uuid()) @db.Uuid
  createdAt     DateTime   @default(now())
  createdBy     User       @relation("createdEducations", fields: [createdById], references: [id])
  createdById   String     @db.Uuid
  updatedAt     DateTime   @updatedAt
  updatedBy     User       @relation("updatedEducations", fields: [updatedById], references: [id])
  updatedById   String     @db.Uuid
  skills        Skill[]    @relation("educationSkills")
  startDate     DateTime
  endDate       DateTime?
  note          String?
  degree        DegreeType
  description   String?
  major         String
  shortMajor    String?
  minor         String?
  concentration String?
  school        School     @relation("educations", fields: [schoolId], references: [id])
  schoolId      String     @db.Uuid
  postPoned     Boolean    @default(false)
  visible       Boolean    @default(true)
  highlighted   Boolean    @default(true)
  courses       Course[]   @relation("courses")

  @@unique([major, schoolId])
  @@unique([shortMajor, schoolId])
}

model Profile {
  id              String   @id @default(uuid()) @db.Uuid
  createdAt       DateTime @default(now())
  createdBy       User     @relation("createdProfiles", fields: [createdById], references: [id])
  createdById     String   @db.Uuid
  updatedAt       DateTime @updatedAt
  updatedBy       User     @relation("updatedProfiles", fields: [updatedById], references: [id])
  updatedById     String   @db.Uuid
  firstName       String
  lastName        String
  displayName     String
  middleName      String?
  profileImageUrl String?
  emailAddress    String
  phoneNumber     String?
  intro           String
  tagline         String?
  githubUrl       String?
  linkedinUrl     String?

  // Additive columns for the parallel new-model foundation. `slug` is nullable until backfilled;
  // `handle` is the social handle rendered beneath the name; `photoFileName` is the locally
  // vendored headshot the generated resume prints from.
  slug          String?                 @unique
  handle        String?
  photoFileName String?
  about         ProfileAboutParagraph[] @relation("about")
  highlights    ProfileHighlight[]      @relation("highlights")
  contacts      ProfileContactEntry[]   @relation("contacts")
}

// ---------------------------------------------------------------------------------------------
// Parallel new-model foundation (content centralization / resume generation).
//
// Successors to the legacy content models, built alongside them so nothing existing breaks:
// `Competency` succeeds `Skill`, `Role` succeeds `Experience`, `Degree` succeeds `Education`, and
// `ContentNode`/`NestedContentNode` succeed `Detail`/`NestedDetail`. The field-level reasoning
// lives in the TypeScript rehearsal of these models (`src/documents/resume/data/types.ts`) and in
// `docs/projects/resume-generation/`. Nothing in the site application reads these models yet.
// ---------------------------------------------------------------------------------------------

// A medium content can be published through. An enum rather than one boolean column per channel so
// adding a channel is a new value, not a migration on every syndicated table.
enum SyndicationChannel {
  LINKEDIN
  RESUME
  WEBSITE
}

// The polymorphic discriminator for `ContentNode.ownerType`. Lives on the child pointing up so
// roles and degrees stay separate models sharing one content tree.
enum ContentOwnerType {
  DEGREE
  ROLE
}

// Summaries sort as a set above content, so the sort key for top-level nodes is `(kind, order)`
// with `SUMMARY` ordering before `CONTENT`.
enum NodeKind {
  CONTENT
  SUMMARY
}

// How a top-level content node presents its children; null on the model means `PARAGRAPH`.
enum NodeType {
  BULLETED_LIST
  NUMBERED_LIST
  PARAGRAPH
}

// Where a node's title sits relative to its content. The default is derived from context at render
// time (inside a list: inline; otherwise stacked) and never persisted.
enum TitleLayout {
  INLINE
  STACKED
}

// How well a `Competency` is known. The primary metric going forward, replacing the derived year
// count the legacy `Skill` leans on.
enum Proficiency {
  ADVANCED
  EXPERT
  FAMILIAR
  PROFICIENT
}

// The icon beside a `ProfileContactEntry`. An enum rather than a filename so the icon set is
// closed; the mapping to a file lives in the renderer.
enum ContactIcon {
  AT
  GITHUB
  GLOBE
  LINKEDIN
}

// Whether a `ResumeCompetenciesGroup` renders its members as proficiency bars or bare pills.
enum ResumeCompetenciesGroupDisplay {
  BARS
  PILLS
}

// The successor to `Skill`. The proficiency tier is the primary metric going forward; the year
// counts are carried across so nothing is lost, but nothing renders from them.
model Competency {
  id                   String                    @id @default(uuid()) @db.Uuid
  createdAt            DateTime                  @default(now())
  createdBy            User                      @relation("createdCompetencies", fields: [createdById], references: [id])
  createdById          String                    @db.Uuid
  updatedAt            DateTime                  @updatedAt
  updatedBy            User                      @relation("updatedCompetencies", fields: [updatedById], references: [id])
  updatedById          String                    @db.Uuid
  slug                 String                    @unique
  label                String                    @unique
  shortLabel           String?
  description          String?
  shortDescription     String?
  proficiency          Proficiency?
  experience           Int?
  calculatedExperience Int?
  isHighlighted        Boolean                   @default(false)
  isPrioritized        Boolean                   @default(false)
  isVisible            Boolean                   @default(true)
  channels             SyndicationChannel[]      @default([])
  roles                Role[]                    @relation("roleCompetencies")
  degrees              Degree[]                  @relation("degreeCompetencies")
  contentNodes         ContentNode[]             @relation("contentNodeCompetencies")
  nestedContentNodes   NestedContentNode[]       @relation("nestedContentNodeCompetencies")
  competencyGroups     ResumeCompetenciesGroup[] @relation("groupCompetencies")
  projects             Project[]                 @relation("projectCompetencies")
  repositories         Repository[]              @relation("repositoryCompetencies")
  courses              Course[]                  @relation("courseCompetencies")
}

// The successor to `Experience`. Its content tree attaches polymorphically through
// `ContentNode.ownerId`/`ownerType`, so no `nodes` relation appears here.
model Role {
  id            String               @id @default(uuid()) @db.Uuid
  createdAt     DateTime             @default(now())
  createdBy     User                 @relation("createdRoles", fields: [createdById], references: [id])
  createdById   String               @db.Uuid
  updatedAt     DateTime             @updatedAt
  updatedBy     User                 @relation("updatedRoles", fields: [updatedById], references: [id])
  updatedById   String               @db.Uuid
  slug          String               @unique
  title         String
  shortTitle    String?
  company       Company              @relation("roles", fields: [companyId], references: [id])
  companyId     String               @db.Uuid
  startDate     DateTime
  endDate       DateTime?
  isCurrent     Boolean              @default(false)
  isRemote      Boolean              @default(false)
  isHighlighted Boolean              @default(false)
  // Where the work was done, not the company's location; null whenever `isRemote` is true.
  city          String?
  state         String?
  isVisible     Boolean              @default(true)
  channels      SyndicationChannel[] @default([])
  competencies  Competency[]         @relation("roleCompetencies")
  resumeSheet   ResumeSheet?         @relation("resumeSheetRoles", fields: [resumeSheetId], references: [id])
  resumeSheetId String?              @db.Uuid

  @@unique([title, companyId])
}

// The successor to `Education`; see `Role` for why there is no `nodes` relation.
model Degree {
  id                 String               @id @default(uuid()) @db.Uuid
  createdAt          DateTime             @default(now())
  createdBy          User                 @relation("createdDegrees", fields: [createdById], references: [id])
  createdById        String               @db.Uuid
  updatedAt          DateTime             @updatedAt
  updatedBy          User                 @relation("updatedDegrees", fields: [updatedById], references: [id])
  updatedById        String               @db.Uuid
  slug               String               @unique
  school             School               @relation("degrees", fields: [schoolId], references: [id])
  schoolId           String               @db.Uuid
  degree             DegreeType
  major              String
  shortMajor         String?
  minor              String?
  shortMinor         String?
  concentration      String?
  shortConcentration String?
  gpa                String?
  note               String?
  shortNote          String?
  startDate          DateTime
  endDate            DateTime?
  isCurrent          Boolean              @default(false)
  isHighlighted      Boolean              @default(false)
  // A degree begun and deliberately paused; renders in place of an end date.
  isPostponed        Boolean              @default(false)
  isVisible          Boolean              @default(true)
  channels           SyndicationChannel[] @default([])
  competencies       Competency[]         @relation("degreeCompetencies")
  courses            Course[]             @relation("degreeCourses")
  resumeSheet        ResumeSheet?         @relation("resumeSheetDegrees", fields: [resumeSheetId], references: [id])
  resumeSheetId      String?              @db.Uuid

  @@unique([major, schoolId])
  @@unique([shortMajor, schoolId])
}

// A top-level node of the two-level content tree: the opening summary prose of a role or degree,
// or a titled body section beneath it. Attaches to its owner polymorphically through
// `ownerId` + `ownerType`, which carries no database-level foreign key — the accepted cost of one
// content tree serving both roles and degrees.
model ContentNode {
  id           String               @id @default(uuid()) @db.Uuid
  createdAt    DateTime             @default(now())
  createdBy    User                 @relation("createdContentNodes", fields: [createdById], references: [id])
  createdById  String               @db.Uuid
  updatedAt    DateTime             @updatedAt
  updatedBy    User                 @relation("updatedContentNodes", fields: [updatedById], references: [id])
  updatedById  String               @db.Uuid
  // Generated rather than authored (a paragraph has no natural name), then sticky once stamped.
  slug         String
  ownerId      String               @db.Uuid
  ownerType    ContentOwnerType
  kind         NodeKind
  // Null means `PARAGRAPH`; meaningless when `kind` is `SUMMARY`.
  type         NodeType?
  // A short bold lead-in, as HTML. A node is never rendered as a title alone.
  title        String?
  // A SINGLE paragraph of HTML; several paragraphs are several nodes, one row each, because
  // syndication is decided per paragraph.
  content      String?
  titleLayout  TitleLayout?
  order        Int
  isVisible    Boolean              @default(true)
  channels     SyndicationChannel[] @default([])
  children     NestedContentNode[]  @relation("children")
  competencies Competency[]         @relation("contentNodeCompetencies")

  @@unique([slug, ownerId, ownerType])
}

// The second and final level of the content tree. Carries no `type` and no children: depth is
// capped at two by the schema itself, which is why this is a separate model rather than a
// self-referential `parentId` on one table.
model NestedContentNode {
  id           String               @id @default(uuid()) @db.Uuid
  createdAt    DateTime             @default(now())
  createdBy    User                 @relation("createdNestedContentNodes", fields: [createdById], references: [id])
  createdById  String               @db.Uuid
  updatedAt    DateTime             @updatedAt
  updatedBy    User                 @relation("updatedNestedContentNodes", fields: [updatedById], references: [id])
  updatedById  String               @db.Uuid
  slug         String
  parent       ContentNode          @relation("children", fields: [parentId], references: [id], onDelete: Cascade)
  parentId     String               @db.Uuid
  title        String?
  content      String?
  titleLayout  TitleLayout?
  order        Int
  isVisible    Boolean              @default(true)
  channels     SyndicationChannel[] @default([])
  competencies Competency[]         @relation("nestedContentNodeCompetencies")

  @@unique([slug, parentId])
}

// One paragraph of the "About" block. Modeled as rows rather than a string array so each
// paragraph has stable identity, explicit order, and its own syndication decision.
model ProfileAboutParagraph {
  id           String               @id @default(uuid()) @db.Uuid
  createdAt    DateTime             @default(now())
  createdBy    User                 @relation("createdProfileAboutParagraphs", fields: [createdById], references: [id])
  createdById  String               @db.Uuid
  updatedAt    DateTime             @updatedAt
  updatedBy    User                 @relation("updatedProfileAboutParagraphs", fields: [updatedById], references: [id])
  updatedById  String               @db.Uuid
  slug         String
  profile      Profile              @relation("about", fields: [profileId], references: [id])
  profileId    String               @db.Uuid
  content      String
  shortContent String?
  order        Int
  isVisible    Boolean              @default(true)
  channels     SyndicationChannel[] @default([])

  @@unique([slug, profileId])
}

// One plus-marked one-liner beneath the "About" block.
model ProfileHighlight {
  id          String               @id @default(uuid()) @db.Uuid
  createdAt   DateTime             @default(now())
  createdBy   User                 @relation("createdProfileHighlights", fields: [createdById], references: [id])
  createdById String               @db.Uuid
  updatedAt   DateTime             @updatedAt
  updatedBy   User                 @relation("updatedProfileHighlights", fields: [updatedById], references: [id])
  updatedById String               @db.Uuid
  slug        String
  profile     Profile              @relation("highlights", fields: [profileId], references: [id])
  profileId   String               @db.Uuid
  text        String
  shortText   String?
  order       Int
  isVisible   Boolean              @default(true)
  channels    SyndicationChannel[] @default([])

  @@unique([slug, profileId])
}

// One icon-labelled row of the contact block.
model ProfileContactEntry {
  id          String               @id @default(uuid()) @db.Uuid
  createdAt   DateTime             @default(now())
  createdBy   User                 @relation("createdProfileContactEntries", fields: [createdById], references: [id])
  createdById String               @db.Uuid
  updatedAt   DateTime             @updatedAt
  updatedBy   User                 @relation("updatedProfileContactEntries", fields: [updatedById], references: [id])
  updatedById String               @db.Uuid
  slug        String
  profile     Profile              @relation("contacts", fields: [profileId], references: [id])
  profileId   String               @db.Uuid
  icon        ContactIcon
  text        String
  shortText   String?
  order       Int
  isVisible   Boolean              @default(true)
  channels    SyndicationChannel[] @default([])

  @@unique([slug, profileId])
}

// One physical 8.5x11 sheet of the printed resume. Page breaks are assigned here by hand; the
// sheet names the roles and degrees it carries and nothing else about them (their order within
// the sheet derives from their start dates). Resume-only presentation — nothing here syndicates.
model ResumeSheet {
  id               String                    @id @default(uuid()) @db.Uuid
  createdAt        DateTime                  @default(now())
  createdBy        User                      @relation("createdResumeSheets", fields: [createdById], references: [id])
  createdById      String                    @db.Uuid
  updatedAt        DateTime                  @updatedAt
  updatedBy        User                      @relation("updatedResumeSheets", fields: [updatedById], references: [id])
  updatedById      String                    @db.Uuid
  // Doubles as the emitted filename: `page-1` becomes `page-1.html`.
  slug             String                    @unique
  order            Int
  // Whether the profile's about/highlights/contact blocks render above this sheet's competency
  // groups; true on the opening sheet only.
  isIntroVisible   Boolean                   @default(false)
  roles            Role[]                    @relation("resumeSheetRoles")
  degrees          Degree[]                  @relation("resumeSheetDegrees")
  competencyGroups ResumeCompetenciesGroup[] @relation("resumeSheetCompetencyGroups")
}

// A titled grouping of competencies in a sheet's sidebar. The bars/pills variance is a display
// flag rather than two shapes: what differs is only whether each member's proficiency is drawn.
model ResumeCompetenciesGroup {
  id            String                         @id @default(uuid()) @db.Uuid
  createdAt     DateTime                       @default(now())
  createdBy     User                           @relation("createdResumeCompetenciesGroups", fields: [createdById], references: [id])
  createdById   String                         @db.Uuid
  updatedAt     DateTime                       @updatedAt
  updatedBy     User                           @relation("updatedResumeCompetenciesGroups", fields: [updatedById], references: [id])
  updatedById   String                         @db.Uuid
  slug          String
  heading       String
  shortHeading  String?
  display       ResumeCompetenciesGroupDisplay
  order         Int
  resumeSheet   ResumeSheet                    @relation("resumeSheetCompetencyGroups", fields: [resumeSheetId], references: [id])
  resumeSheetId String                         @db.Uuid
  competencies  Competency[]                   @relation("groupCompetencies")

  @@unique([slug, resumeSheetId])
}
