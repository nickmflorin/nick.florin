{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "engineStrict": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "validate-node-version": "ts-node --project=./tsconfig.json src/support/enforce-node-version.ts",
    "manual-dev-env-setup": "dotenv -e .env -e .env.development -e .env.local -e .env.development.local -o",
    "manual-prod-env-setup": "dotenv -e .env -e .env.production -e .env.local -e .env.production.local -o",
    "postinstall": "prisma generate",
    "preinstall": "dotenv -e .env -e .env.local -- ts-node --project=./tsconfig.json src/support/enforce-node-version.ts",
    "preadd": "dotenv -e .env -e .env .env.local -- ts-node --project=./tsconfig.json src/support/enforce-node-version.ts",
    "analyze-build": "pnpm validate-node-version && cross-env ANALYZE_BUNDLE=true next build --webpack",
    "build": "pnpm validate-node-version && next build",
    "build:local": "pnpm validate-node-version && rm -rf ./.next && next build",
    "dev": "pnpm validate-node-version && next dev",
    "start": "pnpm validate-node-version && next start",
    "lint": "pnpm validate-node-version && npx eslint .",
    "eslint": "pnpm validate-node-version && npx eslint .",
    "eslint-fix": "pnpm validate-node-version && npx eslint . --fix",
    "prettier-fix": "npx prettier . --write",
    "test": "pnpm validate-node-version && jest --watchAll  --silent=false",
    "test:ci": "pnpm validate-node-version && jest --ci",
    "tsc": "pnpm validate-node-version && tsc --project ./tsconfig.json",
    "tsc:watch": "pnpm validate-node-version && tsc -w",
    "create-migrations": "pnpm validate-node-version && pnpm manual-dev-env-setup -- prisma migrate dev --create-only",
    "migrate-dev": "pnpm validate-node-version && pnpm manual-dev-env-setup -- prisma migrate dev",
    "migrate-prod": "pnpm validate-node-version && pnpm manual-prod-env-setup -- prisma migrate dev",
    "migrate-reset": "pnpm validate-node-version && pnpm manual-dev-env-setup -- prisma migrate reset",
    "migrate-reset-prod": "pnpm validate-node-version && pnpm manual-prod-env-setup -- prisma migrate reset",
    "pushdb": "pnpm validate-node-version && prisma db push",
    "generate-client": "pnpm validate-node-version && prisma generate",
    "seeddb": "pnpm validate-node-version && pnpm manual-dev-env-setup -- cross-env NODE_ENV=development prisma db seed",
    "seeddb-prod": "pnpm validate-node-version && pnpm manual-prod-env-setup -- prisma db seed",
    "jsonify-prod": "pnpm validate-node-version && pnpm manual-prod-env-setup -- npx tsx --tsconfig ./tsconfig.json src/scripts/jsonify/index.ts --live=true && pnpm format-json-fixtures",
    "pullenv": "vercel env pull ./.env --environment=development",
    "pullenv-prod": "vercel env pull ./.env --environment=production",
    "format-json-fixtures": "npx prettier ./src/database/fixtures/json/*.json --write --ignore-path=./.prettierignore",
    "sync-repositories": "pnpm validate-node-version && pnpm manual-dev-env-setup -- npx tsx --tsconfig ./tsconfig.json src/scripts/sync-repositories.ts",
    "sync-repositories-prod": "pnpm validate-node-version && pnpm manual-prod-env-setup -- npx tsx --tsconfig ./tsconfig.json src/scripts/sync-repositories.ts",
    "calculate-experience": "pnpm validate-node-version && pnpm manual-dev-env-setup -- npx tsx --tsconfig ./tsconfig.json src/scripts/calculate-experience.ts",
    "calculate-experience-prod": "pnpm validate-node-version && pnpm manual-prod-env-setup -- npx tsx --tsconfig ./tsconfig.json src/scripts/calculate-experience.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.15.0",
    "@clerk/nextjs": "^7.6.4",
    "@clerk/themes": "^2.4.57",
    "@floating-ui/react": "^0.27.20",
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@hookform/resolvers": "^3.3.4",
    "@mantine/core": "7.17.8",
    "@mantine/dates": "7.17.8",
    "@mantine/dropzone": "7.17.8",
    "@mantine/hooks": "7.17.8",
    "@mui/base": "5.0.0-beta.70",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/theming": "^0.99.0",
    "@prisma/client": "5.22.0",
    "@reactour/tour": "^3.8.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@vercel/analytics": "^1.2.2",
    "@vercel/blob": "^0.22.3",
    "@vercel/speed-insights": "^1.0.10",
    "clsx": "^2.1.0",
    "dotenv": "^16.3.1",
    "dotenv-cli": "^7.3.0",
    "enumerated-literals": "^1.2.5",
    "framer-motion": "^12.43.0",
    "html-react-parser": "^6.1.5",
    "htmlparser2": "^9.1.0",
    "lodash-es": "^4.17.21",
    "luxon": "^3.4.4",
    "next": "16.2.12",
    "next-client-cookies": "^2.1.1",
    "normalize.css": "^8.0.1",
    "pino": "^8.17.2",
    "pino-logflare": "^0.4.2",
    "pino-pretty": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone-esm": "^15.2.0",
    "react-hook-form": "^7.83.0",
    "react-is": "^19.2.8",
    "react-toastify": "^10.0.4",
    "sass": "1.78.0",
    "semver": "^7.5.4",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "swr": "^2.4.2",
    "tailwind-merge": "^2.5.2",
    "use-debounce": "^10.0.0",
    "usehooks-ts": "^3.1.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.0",
    "@next/bundle-analyzer": "^16.2.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^29.5.11",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-is": "^19.2.0",
    "@types/semver": "^7.5.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-expect-message": "^1.1.3",
    "jest-runner-eslint": "^2.1.2",
    "jest-runner-prettier": "^1.0.0",
    "postcss": "^8.4.33",
    "prettier": "3.3.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.4",
    "utility-types": "^3.10.0"
  },
  "prisma": {
    "schema": "src/database/prisma/schema.prisma",
    "seed": "npx tsx --tsconfig ./tsconfig.json src/scripts/seed/index.ts"
  }
}
